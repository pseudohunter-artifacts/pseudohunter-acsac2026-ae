{
  "input": {
    "seed_manifest": "data/synthetic/seed_apks_manifest.json"
  },
  "outputs": {
    "output_root": "outputs/experiments/synthetic_multi_baseline_v4",
    "synthetic_generated_dir": "data/synthetic/generated_apks_v4",
    "synthetic_manifest_dir": "data/synthetic/manifests_v4",
    "synthetic_label_dir": "data/synthetic/labels_v4"
  },
  "synthetic": {
    "transform_families": [
      "xor",
      "base64",
      "split_xor",
      "path_randomized",
      "signature_strip",
      "embedded_asset",
      "so_embedded",
      "dex_method_inlined",
      "multi_dex_shim",
      "embedded_archive",
      "dex_string_encrypted"
    ],
    "rng_seed": 42,
    "asset_prefix": "assets/payload",
    "split_count": 3
  },
  "regioning": {
    "window_size": 4096,
    "stride": 2048,
    "min_region_size": 256,
    "include_tail": true,
    "max_depth": 2,
    "max_member_bytes": 67108864
  },
  "labeling": {
    "min_overlap_bytes": 64,
    "min_overlap_ratio": 0.1
  },
  "baselines": {
    "enabled": ["entropy", "sanity_rules", "ngram_logreg"],
    "entropy": {
      "entropy_threshold": 7.0,
      "entropy_weight": 0.7,
      "nonprintable_weight": 0.3
    },
    "sanity_rules": {
      "threshold": 1.0
    },
    "ngram_logreg": {
      "train_mode": "same_set",
      "C": 1.0,
      "max_iter": 1000,
      "class_weight": "balanced",
      "random_state": 0,
      "threshold": 0.5,
      "include_unigram": true,
      "include_bigram": true,
      "include_scalars": true,
      "bigram_hash_dim": 1024
    },
    "apkid": {
      "min_hits": 1,
      "include_aux_categories": false,
      "timeout_seconds": 120.0
    }
  }
}
